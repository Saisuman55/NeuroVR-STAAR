# NeuroVR / STAAR Environment Configuration Template
# Copy this file to .env to configure local settings.

# Server Settings
NEUROVR_HOST=127.0.0.1
NEUROVR_PORT=5000
NEUROVR_DEBUG=False

# Compute Settings (mps / cuda / cpu)
PYTORCH_ENABLE_MPS_FALLBACK=1
NEUROVR_DEVICE=mps

# Kaggle API Credentials (Optional, only needed if downloading full dataset via scripts)
# KAGGLE_USERNAME=your_kaggle_username
# KAGGLE_KEY=your_kaggle_api_key
